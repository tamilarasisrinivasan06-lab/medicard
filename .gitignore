# ==========================================
# MediCard Unified Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# Build & Distribution Artifacts
dist/
build/
*/dist/
*/build/

# Multer & User Uploaded Storage
uploads/
backend/uploads/

# Runtime Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Temporary Local Files
*.sqlite
*.sqlite3
*.db
pg/data/

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace