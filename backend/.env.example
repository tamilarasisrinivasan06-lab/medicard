PORT=5000

# Option 1: Separate variables (familiar format like MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=medicard

# Option 2: Full connection URL
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/medicard

PGSSLMODE=disable
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
STORAGE_DIR=./uploads
MAX_FILE_SIZE=10485760

# Optional: Google Gemini AI API key for Doctor AI Assistant (works out of the box with grounded engine if omitted)
GEMINI_API_KEY=